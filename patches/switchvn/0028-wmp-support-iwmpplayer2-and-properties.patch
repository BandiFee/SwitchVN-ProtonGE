diff --git a/dlls/wmp/tests/oleobj.c b/dlls/wmp/tests/oleobj.c
index 388c056f09b..ab933dc3880 100644
--- a/dlls/wmp/tests/oleobj.c
+++ b/dlls/wmp/tests/oleobj.c
@@ -361,6 +361,77 @@ static const IOleClientSiteVtbl ClientSiteVtbl = {
 
 static IOleClientSite ClientSite = { &ClientSiteVtbl };
 
+static void test_player_properties(IWMPPlayer4 *player)
+{
+    WMPPlayState play_state;
+    WMPOpenState open_state;
+    VARIANT_BOOL value;
+    HRESULT hr;
+    BSTR mode;
+
+    hr = IWMPPlayer4_get_openState(player, &open_state);
+    ok(hr == S_OK, "get_openState failed, hr %#lx.\n", hr);
+    ok(open_state == wmposUndefined, "Unexpected open state %d.\n", open_state);
+    hr = IWMPPlayer4_get_playState(player, &play_state);
+    ok(hr == S_OK, "get_playState failed, hr %#lx.\n", hr);
+    ok(play_state == wmppsUndefined, "Unexpected play state %d.\n", play_state);
+
+    mode = NULL;
+    hr = IWMPPlayer4_get_uiMode(player, &mode);
+    ok(hr == S_OK, "get_uiMode failed, hr %#lx.\n", hr);
+    ok(mode != NULL, "UI mode is NULL.\n");
+    if (mode)
+        ok(!lstrcmpW(mode, L"full"), "Unexpected UI mode %s.\n", wine_dbgstr_w(mode));
+    SysFreeString(mode);
+    mode = SysAllocString(L"none");
+    hr = IWMPPlayer4_put_uiMode(player, mode);
+    ok(hr == S_OK, "put_uiMode failed, hr %#lx.\n", hr);
+    SysFreeString(mode);
+    mode = NULL;
+    hr = IWMPPlayer4_get_uiMode(player, &mode);
+    ok(hr == S_OK, "get_uiMode failed, hr %#lx.\n", hr);
+    ok(mode != NULL, "UI mode is NULL.\n");
+    if (mode)
+        ok(!lstrcmpW(mode, L"none"), "Unexpected UI mode %s.\n", wine_dbgstr_w(mode));
+    SysFreeString(mode);
+
+    hr = IWMPPlayer4_get_enabled(player, &value);
+    ok(hr == S_OK, "get_enabled failed, hr %#lx.\n", hr);
+    ok(value == VARIANT_TRUE, "Unexpected enabled value %d.\n", value);
+    hr = IWMPPlayer4_put_enabled(player, VARIANT_FALSE);
+    ok(hr == S_OK, "put_enabled failed, hr %#lx.\n", hr);
+    hr = IWMPPlayer4_get_enabled(player, &value);
+    ok(hr == S_OK, "get_enabled failed, hr %#lx.\n", hr);
+    ok(value == VARIANT_FALSE, "Unexpected enabled value %d.\n", value);
+
+    hr = IWMPPlayer4_put_fullScreen(player, VARIANT_TRUE);
+    ok(hr == S_OK, "put_fullScreen failed, hr %#lx.\n", hr);
+    hr = IWMPPlayer4_get_fullScreen(player, &value);
+    ok(hr == S_OK, "get_fullScreen failed, hr %#lx.\n", hr);
+    ok(value == VARIANT_TRUE, "Unexpected fullScreen value %d.\n", value);
+
+    hr = IWMPPlayer4_put_enableContextMenu(player, VARIANT_FALSE);
+    ok(hr == S_OK, "put_enableContextMenu failed, hr %#lx.\n", hr);
+    hr = IWMPPlayer4_get_enableContextMenu(player, &value);
+    ok(hr == S_OK, "get_enableContextMenu failed, hr %#lx.\n", hr);
+    ok(value == VARIANT_FALSE, "Unexpected enableContextMenu value %d.\n", value);
+
+    hr = IWMPPlayer4_put_stretchToFit(player, VARIANT_TRUE);
+    ok(hr == S_OK, "put_stretchToFit failed, hr %#lx.\n", hr);
+    hr = IWMPPlayer4_get_stretchToFit(player, &value);
+    ok(hr == S_OK, "get_stretchToFit failed, hr %#lx.\n", hr);
+    ok(value == VARIANT_TRUE, "Unexpected stretchToFit value %d.\n", value);
+
+    hr = IWMPPlayer4_put_windowlessVideo(player, VARIANT_TRUE);
+    ok(hr == S_OK, "put_windowlessVideo failed, hr %#lx.\n", hr);
+    hr = IWMPPlayer4_get_windowlessVideo(player, &value);
+    ok(hr == S_OK, "get_windowlessVideo failed, hr %#lx.\n", hr);
+    ok(value == VARIANT_TRUE, "Unexpected windowlessVideo value %d.\n", value);
+
+    hr = IWMPPlayer4_close(player);
+    ok(hr == S_OK, "close failed, hr %#lx.\n", hr);
+}
+
