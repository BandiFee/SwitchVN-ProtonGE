From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SwitchVN <switchvn@example.com>
Date: Tue, 25 Aug 2026 00:00:00 +0800
Subject: [PATCH] wmp: support IWMPPlayer2 and player properties

AxInterop.WMPLib queries IWMPPlayer2 while attaching the Windows Media Player
ActiveX control, then configures uiMode before setting the media URL. Wine's
missing interface and E_NOTIMPL property implementations cause AxHost to close
the control before playback starts.

Expose IWMPPlayer2 through the ABI-compatible IWMPPlayer interface and extend
its vtable with the stretchToFit and windowlessVideo slots. Persist the player
presentation properties, track open and playback states, and make close succeed
when no graph exists. Add regression coverage for the interface, defaults and
property round trips.
---

diff --git a/dlls/wmp/oleobj.c b/dlls/wmp/oleobj.c
index b81cb94a9a7..58ee10388be 100644
--- a/dlls/wmp/oleobj.c
+++ b/dlls/wmp/oleobj.c
@@ -23,6 +23,12 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(wmp);
 
+/* IWMPPlayer2 is present in the Windows Media Player type library but is not
+ * declared by Wine's wmp.idl yet.  AxInterop.WMPLib uses it when attaching the
+ * ActiveX control, so expose the ABI-compatible IWMPPlayer interface for it. */
+static const GUID IID_IWMPPlayer2_compat =
+    {0x0e6b01d1, 0xd407, 0x4c85, {0xbf, 0x5f, 0x1c, 0x01, 0xf6, 0x15, 0x02, 0x80}};
+
 static HWND get_container_hwnd(WindowsMediaPlayer *This)
 {
     IOleWindow *ole_window;
@@ -265,6 +271,9 @@ static HRESULT WINAPI OleObject_QueryInterface(IOleObject *iface, REFIID riid, v
     }else if(IsEqualGUID(riid, &IID_IWMPPlayer)) {
         TRACE("(%p)->(IID_IWMPPlayer %p)\n", This, ppv);
         *ppv = &This->IWMPPlayer_iface;
+    }else if(IsEqualGUID(riid, &IID_IWMPPlayer2_compat)) {
+        TRACE("(%p)->(IID_IWMPPlayer2 %p)\n", This, ppv);
+        *ppv = &This->IWMPPlayer_iface;
     }else if(IsEqualGUID(riid, &IID_IWMPSettings)) {
         TRACE("(%p)->(IID_IWMPSettings %p)\n", This, ppv);
         *ppv = &This->IWMPSettings_iface;
