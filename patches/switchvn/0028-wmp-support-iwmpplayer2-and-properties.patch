     IWMPSettings *settings, *settings_qi;
     IWMPPlayer4 *player4;
     IWMPPlayer *player;
@@ -901,6 +988,7 @@ static void test_wmp_ifaces(IOleObject *oleobj)
     IWMPControls *controls;
     VARIANT_BOOL vbool;
