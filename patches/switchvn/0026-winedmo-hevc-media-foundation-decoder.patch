 ]
 coclass wg_h264_decoder {}
 
+[
+    threading(both),
+    uuid(57d81884-432c-449d-9c61-c8abb4d59565)
+]
+coclass winedmo_h265_decoder {}
+
 [
     threading(both),
     uuid(6c34de69-4670-46cd-8cb4-1f2fa1dffb65)
diff --git a/dlls/winedmo/winedmo_private.h b/dlls/winedmo/winedmo_private.h
--- a/dlls/winedmo/winedmo_private.h
+++ b/dlls/winedmo/winedmo_private.h
@@ -114,5 +114,7 @@ HRESULT aac_decoder_create(REFIID riid, void **ret);
 HRESULT h264_decoder_create(REFIID riid, void **ret);
