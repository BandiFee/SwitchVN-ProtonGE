+HRESULT h265_decoder_create(REFIID riid, void **ret);
+HRESULT h265_decoder_create_aggregated(IUnknown *outer, REFIID riid, void **ret);
 HRESULT video_processor_create(REFIID riid, void **ret);
 HRESULT winedmo_scheme_handler_create(REFIID riid, void **ret);
 
diff --git a/dlls/winedmo/unix_transform.c b/dlls/winedmo/unix_transform.c
--- a/dlls/winedmo/unix_transform.c
+++ b/dlls/winedmo/unix_transform.c
@@ -173,6 +173,7 @@ static enum AVCodecID codec_id_from_video_format( const MFVIDEOFORMAT *mfvf )
         return AV_CODEC_ID_H264;
     case MAKEFOURCC('H','E','V','C'): case MAKEFOURCC('h','e','v','c'):
     case MAKEFOURCC('H','2','6','5'): case MAKEFOURCC('h','2','6','5'):
+    case MAKEFOURCC('H','E','V','S'): case MAKEFOURCC('h','e','v','s'):
         return AV_CODEC_ID_HEVC;
     case MAKEFOURCC('V','P','8','0'):  return AV_CODEC_ID_VP8;
     case MAKEFOURCC('V','P','9','0'):  return AV_CODEC_ID_VP9;
