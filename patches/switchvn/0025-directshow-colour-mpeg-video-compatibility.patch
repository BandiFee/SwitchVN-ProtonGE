+    hr = IEnumMediaTypes_Next(enummt, 1, &output_mt, NULL);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    vih = (VIDEOINFOHEADER *)output_mt->pbFormat;
+    ok(vih->bmiHeader.biWidth == 32, "Got width %ld.\n", vih->bmiHeader.biWidth);
+    ok(vih->bmiHeader.biHeight == 24, "Got height %ld.\n", vih->bmiHeader.biHeight);
+    ok(vih->AvgTimePerFrame == 400000, "Got frame duration %s.\n",
+            wine_dbgstr_longlong(vih->AvgTimePerFrame));
+    ok(vih->bmiHeader.biSizeImage == 32 * 24 * 3 / 2, "Got image size %lu.\n",
+            vih->bmiHeader.biSizeImage);
