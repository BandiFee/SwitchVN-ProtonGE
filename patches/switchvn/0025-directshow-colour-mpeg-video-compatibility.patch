+static NTSTATUS mpeg1_wave_format_from_codec_params( const AVCodecParameters *params,
+                                                     MPEG1WAVEFORMAT *format, UINT32 *format_size )
+{
+    UINT32 capacity = *format_size;
+
+    *format_size = sizeof(*format) + params->extradata_size;
+    if (*format_size > capacity)
+        return STATUS_BUFFER_TOO_SMALL;
+
+    wave_format_ex_init( params, &format->wfx, *format_size, WAVE_FORMAT_MPEG );
+    if (params->extradata_size && params->extradata)
+        memcpy( format + 1, params->extradata, params->extradata_size );
+
+    if (params->codec_id == AV_CODEC_ID_MP1)
+        format->fwHeadLayer = ACM_MPEG_LAYER1;
+    else
+        format->fwHeadLayer = ACM_MPEG_LAYER2;
+
+    format->dwHeadBitrate = params->bit_rate;
+    format->fwHeadMode = format->wfx.nChannels == 1 ? ACM_MPEG_SINGLECHANNEL : ACM_MPEG_STEREO;
+    format->fwHeadFlags = ACM_MPEG_ID_MPEG1;
+
+    if (!format->wfx.nBlockAlign && format->wfx.nSamplesPerSec && params->bit_rate)
+    {
+        if (format->fwHeadLayer == ACM_MPEG_LAYER1)
+            format->wfx.nBlockAlign = 4 * (12 * params->bit_rate / format->wfx.nSamplesPerSec);
+        else
+            format->wfx.nBlockAlign = 144 * params->bit_rate / format->wfx.nSamplesPerSec;
+    }
+
+    TRACE( "MPEG layer %#x, tag %#x, %u channels, sample rate %u, %u bytes/sec, "
+           "alignment %u, bitrate %u.\n", format->fwHeadLayer, format->wfx.wFormatTag,
+           format->wfx.nChannels, format->wfx.nSamplesPerSec, format->wfx.nAvgBytesPerSec,
+           format->wfx.nBlockAlign, format->dwHeadBitrate );
+    if (params->extradata_size)
+        TRACE_HEXDUMP( format + 1, params->extradata_size );
+
+    return STATUS_SUCCESS;
+}
