+static HRESULT create_dmo_media_type(IMFMediaType *base_type, const GUID *subtype,
+        DMO_MEDIA_TYPE *dmo_type)
+{
+    IMFMediaType *media_type;
+    AM_MEDIA_TYPE *am_type;
+    GUID current_subtype;
+    UINT64 frame_size;
+    UINT32 image_size;
+    LONG stride;
+    HRESULT hr;
+
+    if (FAILED(hr = MFCreateMediaType(&media_type)))
+        return hr;
+
+    if (base_type && FAILED(hr = IMFMediaType_CopyAllItems(base_type, (IMFAttributes *)media_type)))
+        goto done;
+    if (FAILED(hr = IMFMediaType_SetGUID(media_type, &MF_MT_MAJOR_TYPE, &MFMediaType_Video)))
+        goto done;
+    if (subtype && FAILED(hr = IMFMediaType_SetGUID(media_type, &MF_MT_SUBTYPE, subtype)))
+        goto done;
+    if (FAILED(hr = IMFMediaType_SetUINT32(media_type, &MF_MT_FIXED_SIZE_SAMPLES, TRUE)))
+        goto done;
+    if (FAILED(hr = IMFMediaType_SetUINT32(media_type, &MF_MT_ALL_SAMPLES_INDEPENDENT, TRUE)))
+        goto done;
+
+    if (!subtype)
+    {
+        if (FAILED(hr = IMFMediaType_GetGUID(media_type, &MF_MT_SUBTYPE, &current_subtype)))
+            goto done;
+        subtype = &current_subtype;
+    }
+    if (SUCCEEDED(IMFMediaType_GetUINT64(media_type, &MF_MT_FRAME_SIZE, &frame_size)))
+    {
+        if (SUCCEEDED(MFGetStrideForBitmapInfoHeader(subtype->Data1, frame_size >> 32, &stride)))
+            IMFMediaType_SetUINT32(media_type, &MF_MT_DEFAULT_STRIDE, abs(stride));
+        if (SUCCEEDED(MFCalculateImageSize(subtype, frame_size >> 32, (UINT32)frame_size, &image_size)))
+            IMFMediaType_SetUINT32(media_type, &MF_MT_SAMPLE_SIZE, image_size);
+    }
+
+    if (FAILED(hr = MFCreateAMMediaTypeFromMFMediaType(media_type, GUID_NULL, &am_type)))
+        goto done;
+
+    *dmo_type = *(DMO_MEDIA_TYPE *)am_type;
+    CoTaskMemFree(am_type);
+
+done:
+    IMFMediaType_Release(media_type);
+    return hr;
+}
+
+static HRESULT create_mf_media_type(const DMO_MEDIA_TYPE *dmo_type, IMFMediaType **media_type)
+{
+    return MFCreateMediaTypeFromRepresentation(AM_MEDIA_TYPE_REPRESENTATION,
+            (void *)dmo_type, media_type);
+}
