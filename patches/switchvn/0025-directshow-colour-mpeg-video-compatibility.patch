+static BOOL mpeg_video_codec_get_sequence_format(const AM_MEDIA_TYPE *mt, LONG *width, LONG *height,
+        REFERENCE_TIME *frame_duration)
+{
+    static const struct
+    {
+        UINT numerator;
+        UINT denominator;
+    } frame_rates[] =
+    {
+        {0, 1},
+        {24000, 1001},
+        {24, 1},
+        {25, 1},
+        {30000, 1001},
+        {30, 1},
+        {50, 1},
+        {60000, 1001},
+        {60, 1},
+    };
+    const MPEG1VIDEOINFO *format;
+    DWORD sequence_size, i;
+
+    if (!IsEqualGUID(&mt->formattype, &FORMAT_MPEGVideo)
+            || mt->cbFormat < offsetof(MPEG1VIDEOINFO, bSequenceHeader) || !mt->pbFormat)
+        return FALSE;
+
+    format = (const MPEG1VIDEOINFO *)mt->pbFormat;
+    sequence_size = min(format->cbSequenceHeader,
+            mt->cbFormat - offsetof(MPEG1VIDEOINFO, bSequenceHeader));
+
+    for (i = 0; i + 7 < sequence_size; ++i)
+    {
+        UINT frame_rate_code;
+
+        if (format->bSequenceHeader[i] || format->bSequenceHeader[i + 1]
+                || format->bSequenceHeader[i + 2] != 1 || format->bSequenceHeader[i + 3] != 0xb3)
+            continue;
+
+        *width = (format->bSequenceHeader[i + 4] << 4) | (format->bSequenceHeader[i + 5] >> 4);
+        *height = ((format->bSequenceHeader[i + 5] & 0x0f) << 8) | format->bSequenceHeader[i + 6];
+        frame_rate_code = format->bSequenceHeader[i + 7] & 0x0f;
+        if (frame_rate_code < ARRAY_SIZE(frame_rates) && frame_rates[frame_rate_code].numerator)
+            *frame_duration = MulDiv(10000000, frame_rates[frame_rate_code].denominator,
+                    frame_rates[frame_rate_code].numerator);
+        return *width && *height;
+    }
+
+    return FALSE;
+}
