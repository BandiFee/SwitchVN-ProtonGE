index 301b05899e..26e225cb7b 100644
--- a/dlls/qasf/dmowrapper.c
+++ b/dlls/qasf/dmowrapper.c
@@ -761,7 +761,7 @@ static HRESULT WINAPI dmo_wrapper_filter_Init(IDMOWrapperFilter *iface, REFCLSID
         free(buffers);
         IMediaObject_Release(dmo);
         IUnknown_Release(unk);
-        return hr;
+        return E_OUTOFMEMORY;
     }
 
     for (i = 0; i < input_count; ++i)
@@ -980,7 +980,7 @@ static struct strmbase_filter_ops filter_ops =
     .filter_cleanup_stream = dmo_wrapper_cleanup_stream,
 };
 
-HRESULT dmo_wrapper_create(IUnknown *outer, IUnknown **out)
+static HRESULT dmo_wrapper_create_with_clsid(IUnknown *outer, const CLSID *clsid, IUnknown **out)
 {
     struct dmo_wrapper *object;
 
@@ -988,7 +988,7 @@ HRESULT dmo_wrapper_create(IUnknown *outer, IUnknown **out)
         return E_OUTOFMEMORY;
 
     /* Always pass NULL as the outer object; see test_aggregation(). */
-    strmbase_filter_init(&object->filter, NULL, &CLSID_DMOWrapperFilter, &filter_ops);
+    strmbase_filter_init(&object->filter, NULL, clsid, &filter_ops);
 
     object->IDMOWrapperFilter_iface.lpVtbl = &dmo_wrapper_filter_vtbl;
     object->IAMFilterMiscFlags_iface.lpVtbl = &dmo_wrapper_misc_flags_vtbl;
@@ -1000,3 +1000,34 @@ HRESULT dmo_wrapper_create(IUnknown *outer, IUnknown **out)
 
     return S_OK;
 }
+
+HRESULT dmo_wrapper_create(IUnknown *outer, IUnknown **out)
+{
+    return dmo_wrapper_create_with_clsid(outer, &CLSID_DMOWrapperFilter, out);
+}
+
+HRESULT color_converter_create(IUnknown *outer, IUnknown **out)
+{
+    static const GUID CLSID_winedmo_color_converter =
+            {0xf47e2da5,0xe370,0x47b7,{0x90,0x3a,0x07,0x8d,0xdd,0x45,0xa5,0xcc}};
+    IDMOWrapperFilter *wrapper;
+    IUnknown *unknown;
+    HRESULT hr;
+
+    if (FAILED(hr = dmo_wrapper_create_with_clsid(outer, &CLSID_Colour, &unknown)))
+        return hr;
+
+    if (SUCCEEDED(hr = IUnknown_QueryInterface(unknown, &IID_IDMOWrapperFilter, (void **)&wrapper)))
+    {
+        hr = IDMOWrapperFilter_Init(wrapper, &CLSID_winedmo_color_converter, &DMOCATEGORY_VIDEO_EFFECT);
+        IDMOWrapperFilter_Release(wrapper);
+    }
+    if (FAILED(hr))
+    {
+        IUnknown_Release(unknown);
+        return hr;
+    }
+
+    *out = unknown;
+    return S_OK;
+}
