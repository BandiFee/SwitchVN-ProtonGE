+static void test_colour_converter(void)
+{
+    VIDEOINFOHEADER input_vih = {.bmiHeader = {sizeof(BITMAPINFOHEADER), 2, 2, 1, 16,
+            MAKEFOURCC('Y','U','Y','2'), 8}};
+    VIDEOINFOHEADER output_vih = {.bmiHeader = {sizeof(BITMAPINFOHEADER), 2, 2, 1, 32,
+            BI_RGB, 16}};
+    AM_MEDIA_TYPE input_mt = {MEDIATYPE_Video, MEDIASUBTYPE_YUY2, TRUE, FALSE, 8,
+            FORMAT_VideoInfo, NULL, sizeof(input_vih), (BYTE *)&input_vih};
+    AM_MEDIA_TYPE output_mt = {MEDIATYPE_Video, MEDIASUBTYPE_RGB32, TRUE, FALSE, 16,
+            FORMAT_VideoInfo, NULL, sizeof(output_vih), (BYTE *)&output_vih};
+    static const BYTE frame[] = {81, 90, 145, 240, 41, 240, 210, 110};
+    struct testfilter testsource, testsink;
+    IMediaControl *control = NULL;
+    IMemInputPin *input = NULL;
+    IMediaSample *sample = NULL;
+    IMediaFilter *media_filter;
+    IBaseFilter *filter;
+    IUnknown *unknown;
+    IEnumPins *enum_pins;
+    IPersist *persist;
+    IFilterGraph2 *graph;
+    PIN_DIRECTION direction;
+    IPin *pins[3] = {0};
+    CLSID clsid;
+    ULONG count;
+    DWORD wait;
+    BYTE *data;
+    HRESULT hr;
+
+    hr = CoCreateInstance(&CLSID_Colour, NULL, CLSCTX_INPROC_SERVER,
+            &IID_IBaseFilter, (void **)&filter);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    if (FAILED(hr))
+        return;
+
+    hr = IBaseFilter_QueryInterface(filter, &IID_IUnknown, (void **)&unknown);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    if (SUCCEEDED(hr)) IUnknown_Release(unknown);
+
+    hr = IBaseFilter_QueryInterface(filter, &IID_IMediaFilter, (void **)&media_filter);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    if (SUCCEEDED(hr)) IMediaFilter_Release(media_filter);
+
+    hr = IBaseFilter_QueryInterface(filter, &IID_IPersist, (void **)&persist);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        hr = IPersist_GetClassID(persist, &clsid);
+        ok(hr == S_OK, "Got hr %#lx.\n", hr);
+        ok(IsEqualGUID(&clsid, &CLSID_Colour), "Got class ID %s.\n", wine_dbgstr_guid(&clsid));
+        IPersist_Release(persist);
+    }
+
+    hr = IBaseFilter_EnumPins(filter, &enum_pins);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        hr = IEnumPins_Next(enum_pins, ARRAY_SIZE(pins), pins, &count);
+        ok(hr == S_FALSE, "Got hr %#lx.\n", hr);
+        ok(count == 2, "Got %lu pins.\n", count);
+        if (count > 0)
+        {
+            hr = IPin_QueryDirection(pins[0], &direction);
+            ok(hr == S_OK, "Got hr %#lx.\n", hr);
+            ok(direction == PINDIR_INPUT, "Got direction %u.\n", direction);
+        }
+        if (count > 1)
+        {
+            hr = IPin_QueryDirection(pins[1], &direction);
+            ok(hr == S_OK, "Got hr %#lx.\n", hr);
+            ok(direction == PINDIR_OUTPUT, "Got direction %u.\n", direction);
+        }
+        if (count > 2) IPin_Release(pins[2]);
+        IEnumPins_Release(enum_pins);
+    }
+
+    testfilter_init(&testsource);
+    testfilter_init(&testsink);
+    testsink.sink_mt = &output_mt;
+    hr = CoCreateInstance(&CLSID_FilterGraph, NULL, CLSCTX_INPROC_SERVER,
+            &IID_IFilterGraph2, (void **)&graph);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        IFilterGraph2_AddFilter(graph, &testsource.filter.IBaseFilter_iface, L"source");
+        IFilterGraph2_AddFilter(graph, filter, L"Colour");
+        IFilterGraph2_AddFilter(graph, &testsink.filter.IBaseFilter_iface, L"sink");
+        if (pins[0] && pins[1])
+        {
+            hr = IFilterGraph2_ConnectDirect(graph, &testsource.source.pin.IPin_iface,
+                    pins[0], &input_mt);
+            ok(hr == S_OK, "Got hr %#lx.\n", hr);
+            hr = IFilterGraph2_ConnectDirect(graph, pins[1], &testsink.sink.pin.IPin_iface,
+                    &output_mt);
+            ok(hr == S_OK, "Got hr %#lx.\n", hr);
+            if (SUCCEEDED(hr))
+            {
+                hr = IPin_QueryInterface(pins[0], &IID_IMemInputPin, (void **)&input);
+                ok(hr == S_OK, "Got hr %#lx.\n", hr);
+                hr = IFilterGraph2_QueryInterface(graph, &IID_IMediaControl, (void **)&control);
+                ok(hr == S_OK, "Got hr %#lx.\n", hr);
+                if (input && control)
+                {
+                    hr = IMediaControl_Pause(control);
+                    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+                    ok(!!testsource.source.pAllocator, "Expected an input allocator.\n");
+                    if (testsource.source.pAllocator)
+                    {
+                        hr = IMemAllocator_GetBuffer(testsource.source.pAllocator, &sample, NULL, NULL, 0);
+                        ok(hr == S_OK, "Got hr %#lx.\n", hr);
+                        if (SUCCEEDED(hr))
+                        {
+                            hr = IMediaSample_GetPointer(sample, &data);
+                            ok(hr == S_OK, "Got hr %#lx.\n", hr);
+                            if (SUCCEEDED(hr))
+                            {
+                                memcpy(data, frame, sizeof(frame));
+                                hr = IMediaSample_SetActualDataLength(sample, sizeof(frame));
+                                ok(hr == S_OK, "Got hr %#lx.\n", hr);
+                                IMediaSample_SetSyncPoint(sample, TRUE);
+                                got_Receive = 0;
+                                testmode = 200;
+                                hr = IMemInputPin_Receive(input, sample);
+                                ok(hr == S_OK, "Got hr %#lx.\n", hr);
+                                wait = WaitForSingleObject(testsink.event, 5000);
+                                ok(wait == WAIT_OBJECT_0, "Wait returned %#lx.\n", wait);
+                                ok(got_Receive == 1, "Got %u calls to Receive().\n", got_Receive);
+                                testmode = 0;
+                            }
+                        }
+                    }
+                    IMediaControl_Stop(control);
+                }
+            }
+        }
+        if (sample) IMediaSample_Release(sample);
+        if (input) IMemInputPin_Release(input);
+        if (control) IMediaControl_Release(control);
+        IFilterGraph2_Release(graph);
+    }
+    if (pins[0]) IPin_Release(pins[0]);
+    if (pins[1]) IPin_Release(pins[1]);
+    IBaseFilter_Release(&testsource.filter.IBaseFilter_iface);
+    IBaseFilter_Release(&testsink.filter.IBaseFilter_iface);
+
+    IBaseFilter_Release(filter);
+}
+
 START_TEST(dmowrapper)
